          },
          "expr": "histogram_quantile(0.5, sum by (le, backend) (rate(rameness_jev_decision_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "p50 {{backend}}",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, backend) (rate(rameness_jev_decision_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "p95 {{backend}}",
          "refId": "B",
          "instant": false,
