    {
      "type": "bargauge",
      "title": "Who decided (all time)",
      "description": "jev: the decision model alone; director: you decided.",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (gate) (rameness_decisions{instance=~\"$instance\"})",
          "legendFormat": "{{gate}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
